{
  "name": "ranimontagna.com",
  "version": "1.27.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && node scripts/compile-hints.mjs",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "pnpm biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --incremental false",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:ci": "lhci autorun --config=./lighthouserc.ci.json",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chat:eval": "node scripts/chat-live-eval.mjs",
    "cv:generate": "python3 scripts/generate-cv.py"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@react-three/fiber": "^9.8.1",
    "@sentry/nextjs": "^11.6.0",
    "@solar-icons/react": "^2.3.2",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^14.1.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "mermaid": "^12.1.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
