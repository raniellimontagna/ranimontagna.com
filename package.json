{
  "name": "ranimontagna.com",
  "version": "1.28.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && node scripts/compile-hints.mjs",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "pnpm biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --incremental false",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:ci": "lhci autorun --config=./lighthouserc.ci.json",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chat:eval": "node scripts/chat-live-eval.mjs",
    "cases:stills": "node scripts/case-stills.mjs",
    "images:copies": "node scripts/image-copies.mjs",
    "cv:generate": "python3 scripts/generate-cv.py"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@octokit/rest": "^22.0.1",
    "@sentry/nextjs": "^11.11.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@lhci/cli": "0.16.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "31.0.0",
    "knip": "^6.44.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
