{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/en/projects",
        "http://localhost:3000/en/blog",
        "http://localhost:3000/en/blog/um-novo-capitulo-na-lemon"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "onlyCategories": ["performance", "seo", "accessibility"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3000/(?:en)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 800000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/en/projects$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 250 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 880000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/en/blog$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 250 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 1020000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/en/blog/um-novo-capitulo-na-lemon$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 250 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 1040000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
